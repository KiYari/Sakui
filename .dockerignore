# Build context for server/Dockerfile is the repo root, so everything the Gradle
# build doesn't need is excluded here — both to keep the context small and to stop
# host-built artifacts (Windows-compiled node_modules, stale class files) from
# leaking into a Linux image.
.git
.gitignore
.gitattributes

# Build outputs — the image builds these itself
**/build
.gradle
**/.gradle
web/node_modules
web/dist

# The web image has its own context (./web); the server build never needs it
web

# IDE / tooling
.idea
*.iml
.vscode
.claude
.claude-flow

# Vendored copy of the upstream project this one ports; not part of any build
reference

# Generated knowledge-graph artifacts
graphify-out

# Docs and local env
*.md
.env
.env.*
!.env.example
