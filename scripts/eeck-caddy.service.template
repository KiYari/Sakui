# Companion to eeck.service.template, for exposing eeck on the open
# internet with automatic HTTPS (Let's Encrypt) instead of plain HTTP.
# Caddy terminates TLS and reverse-proxies to the eeck service, which must
# be bound to 127.0.0.1 for this to be safe - see the EECK_HOST line in
# eeck.service.template.
#
# 1. In /opt/eeck (see eeck.service.template step 1), you already have
#    caddy and Caddyfile from the release build. Grant the binary
#    permission to bind ports 80/443 without running it as root:
#      sudo setcap 'cap_net_bind_service=+ep' /opt/eeck/caddy
# 2. Fill in the placeholders below, save as
#    /etc/systemd/system/eeck-caddy.service.
# 3. Point this domain's DNS A record at this machine's public IP, and open
#    ports 80 and 443 inbound (firewall / cloud security group) - Caddy
#    needs both, even for an HTTPS-only site: port 80 answers the ACME
#    challenge and redirects to 443.
# 4. Uncomment `Environment=EECK_HOST=127.0.0.1` in eeck.service.template,
#    then:
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now eeck eeck-caddy
#      sudo systemctl status eeck-caddy
#      sudo journalctl -u eeck-caddy -f

[Unit]
Description=Caddy (TLS reverse proxy for eeck)
After=network.target eeck.service
Requires=eeck.service

[Service]
Type=simple
User=eeck
Group=eeck
WorkingDirectory=/opt/eeck
Environment=EECK_DOMAIN=your-domain.example.com
Environment=EECK_PORT=3001
ExecStart=/opt/eeck/caddy run --config /opt/eeck/Caddyfile
Restart=on-failure
RestartSec=2

# Caddy needs this even running as a non-root user, to bind 80/443.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
