# Copy to .env next to docker-compose.yml; compose reads it automatically.
# Every value below has a working default, so an empty .env still deploys.

# Host port the app is published on. Plain HTTP deploys leave this at 80.
# With the TLS overlay, bind it to loopback so only Caddy faces the internet:
#   EECK_HTTP_PORT=127.0.0.1:8080
EECK_HTTP_PORT=80

# Required ONLY by docker-compose.tls.yml. Must already resolve to this host.
# EECK_DOMAIN=chat.example.com

# Unused in the default single-origin topology (nginx serves the SPA and proxies
# /api + /ws, so requests are same-origin and never trigger CORS). Only matters
# if you split the frontend onto a different origin than the API.
# EECK_CORS_HOST=chat.example.com
