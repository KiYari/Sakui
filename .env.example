# Copy this file to `.env` (not edited in place: nothing reads .env.example). Docker Compose
# and the server itself both read `.env`. Restart the server after changing it.
# Every value below has a working default, so an empty .env still deploys.

# Host port the app is published on. Plain HTTP deploys leave this at 80.
# With the TLS overlay, bind it to loopback so only Caddy faces the internet:
#   EECK_HTTP_PORT=127.0.0.1:8080
EECK_HTTP_PORT=80

# Required ONLY by docker-compose.tls.yml. Must already resolve to this host.
# EECK_DOMAIN=chat.example.com

# Access key: when set, nobody can create or join chats on this server without it
# (health checks stay public). Comma separated keys are all accepted, so one can be
# rotated without downtime. Use a long random value:  openssl rand -hex 24
# Clients type it on the first screen and their browser remembers it per server.
# EECK_ACCESS_KEY=

# Which server(s) the web client talks to.
#   same-origin (default): the bundled server behind this nginx; no server prompt.
#   relay: the first screen asks for a server's public IPv4 address; this web
#          host forwards to it, so that server may speak plain HTTP.
# Changing it needs a rebuild: docker compose up -d --build
# EECK_SERVER_MODE=same-origin

# Unused in the default single-origin topology (nginx serves the SPA and proxies
# /api + /ws, so requests are same-origin and never trigger CORS). Only matters
# if you host the frontend on a different origin than the API (e.g. Vercel, built
# with web/vercel.json). Comma separated: chat.example.com,eeck.vercel.app
# EECK_CORS_HOST=chat.example.com
